{
  "rules": [
    {
      "allowed": {
        "origins": ["https://earthlapse.net", "https://www.earthlapse.net", "http://localhost:3000"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
